{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "off"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-ssr/**",
    "**/coverage/**",
    ".pnpmfile.cjs"
  ],
  "rules": {
    // Правила React, дублировавшиеся в @eslint-react, и a11y (strict)
    "react/no-array-index-key": "error",
    "react/no-children-prop": "error",
    "react/no-clone-element": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-render-return-value": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-danger": "error",
    "react/no-danger-with-children": "error",
    "react/jsx-no-script-url": "error",
    "react/iframe-missing-sandbox": "error",
    "react/void-dom-elements-no-children": "error",
    "react/button-has-type": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-namespace": "error",
    "react/jsx-key": "error",
    "react/no-react-children": "error",
    "react/no-unsafe": "error",
    "react/no-did-mount-set-state": "error",
    "react/no-did-update-set-state": "error",
    "react/no-will-update-set-state": "error",
    "react/no-object-type-as-default-prop": "error",
    "react/no-unstable-nested-components": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/prefer-function-component": "error",
    "react/jsx-pascal-case": "error",
    "react/jsx-fragments": "error",
    "react/hook-use-state": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/style-prop-object": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "react/forward-ref-uses-ref": "error",
    "react/no-this-in-sfc": "error",
    "react/no-string-refs": "error",
    "react/no-is-mounted": "error",
    "react/no-set-state": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/self-closing-comp": "error",
    "react/display-name": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    // Правила, которые есть в strict-пресетах ESLint, но не входят в выбранные категории
    "no-empty": "error",
    "no-regex-spaces": "error",
    "no-var": "error",
    "no-empty-function": "error",
    "@typescript-eslint/no-dynamic-delete": "error",
    "@typescript-eslint/no-empty-object-type": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-invalid-void-type": "error",
    "@typescript-eslint/no-namespace": "error",
    "@typescript-eslint/no-non-null-asserted-nullish-coalescing": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/prefer-literal-enum-member": "error",
    "@typescript-eslint/use-unknown-in-catch-callback-variable": "error",
    "@typescript-eslint/non-nullable-type-assertion-style": "error",
    // React Hooks и React Compiler
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/exhaustive-effect-dependencies": "error",
    "react-hooks/memo-dependencies": "error",
    "react-hooks/capitalized-calls": "error",
    "react-hooks/error-boundaries": "error",
    "react-hooks/globals": "error",
    "react-hooks/hooks": "error",
    "react-hooks/immutability": "error",
    "react-hooks/incompatible-library": "error",
    "react-hooks/invariant": "error",
    "react-hooks/no-deriving-state-in-effects": "error",
    "react-hooks/preserve-manual-memoization": "error",
    "react-hooks/purity": "error",
    "react-hooks/refs": "error",
    "react-hooks/rule-suppression": "error",
    "react-hooks/set-state-in-effect": "error",
    "react-hooks/set-state-in-render": "error",
    "react-hooks/static-components": "error",
    "react-hooks/syntax": "error",
    "react-hooks/todo": "error",
    "react-hooks/unsupported-syntax": "error",
    "react-hooks/use-memo": "error",
    "react-hooks/void-use-memo": "error",
    // Правила, которые конфликтуют друг с другом или с принятыми в React практиками
    "no-ternary": "off",
    "no-undefined": "off",
    "no-magic-numbers": "off",
    "no-inline-comments": "off",
    "no-continue": "off",
    "no-plusplus": "off",
    "no-negated-condition": "off",
    "no-void": ["error", { "allowAsStatement": true }],
    "id-length": "off",
    "init-declarations": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "capitalized-comments": "off",
    "max-statements": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-params": "off",
    "max-classes-per-file": "off",
    "func-names": "off",
    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "arrow-body-style": ["error", "as-needed"],
    "prefer-destructuring": "off",
    "one-var": "off",
    "no-await-in-loop": "off",
    "no-console": ["error", { "allow": ["warn", "error", "info"] }],
    "no-shadow": ["error", { "hoist": "all" }],
    "no-use-before-define": ["error", { "functions": false }],
    "no-warning-comments": "off",
    "eqeqeq": ["error", "always"],
    "radix": "error",
    "default-param-last": "error",
    "unicorn/no-null": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/switch-case-braces": "off",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/prefer-global-this": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-anonymous-default-export": "off",
    "import/max-dependencies": "off",
    "import/no-nodejs-modules": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    // Типы импортируются отдельной строкой `import type` (см. правило выше),
    // поэтому отдельный type-импорт из того же модуля дублем не считается
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "import/no-commonjs": "error",
    "node/no-process-env": "off",
    "@typescript-eslint/no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "@typescript-eslint/restrict-template-expressions": ["error", { "allowNumber": true, "allowNever": true }],
    "@typescript-eslint/return-await": ["error", "error-handling-correctness-only"],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-magic-numbers": "off",
    "@typescript-eslint/prefer-readonly-parameter-types": "off",
    "@typescript-eslint/no-unsafe-type-assertion": "off",
    "@typescript-eslint/strict-boolean-expressions": "off",
    "@typescript-eslint/parameter-properties": "off",
    "@typescript-eslint/no-require-imports": "error",
    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports", "fixStyle": "separate-type-imports" }],
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "react/jsx-no-literals": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-handler-names": "off",
    "react/forbid-component-props": "off",
    "react/forbid-dom-props": "off",
    "react/forbid-elements": "off",
    "react/no-multi-comp": ["error", { "ignoreStateless": false }],
    "react/jsx-boolean-value": ["error", "never"],
    "react/jsx-curly-brace-presence": ["error", { "props": "never", "children": "never" }],
    "react/function-component-definition": ["error", { "namedComponents": "arrow-function", "unnamedComponents": "arrow-function" }],
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "no-underscore-dangle": ["error", { "allow": ["_exhaustiveCheck"] }]
  },
  "overrides": [
    {
      "files": ["*.config.{js,mjs,cjs,ts,mts}", ".pnpmfile.cjs"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-commonjs": "off",
        "@typescript-eslint/no-require-imports": "off",
        "unicorn/prefer-module": "off",
        "import/no-unassigned-import": "off"
      },
      "env": { "node": true }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "src/tests/**"],
      "rules": {
        "@typescript-eslint/unbound-method": "off",
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ]
}
