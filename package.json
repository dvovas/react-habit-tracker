{
  "name": "front-habit-tracker-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "preview": "vite preview",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "eslint": "eslint . --max-warnings 0",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "steiger": "steiger src",
    "lint": "run-p --continue-on-error oxlint eslint stylelint",
    "lint:fix:js": "run-s oxlint:fix eslint:fix",
    "lint:fix": "run-p --continue-on-error stylelint:fix lint:fix:js",
    "check": "run-p --continue-on-error type-check steiger stylelint:fix lint:fix:js"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@iconify/react": "^6.0.2",
    "@reactuses/core": "^6.5.9",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@conarti/eslint-plugin-feature-sliced": "^2.0.1",
    "@eslint-react/eslint-plugin": "^5.24.10",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@steiger/toolkit": "^0.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sass": "^1.105.1",
    "steiger": "^0.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
